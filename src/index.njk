---
layout: layouts/base.njk
title: Heim
---
{#-
  Homepage. Immersive-teal brand, content baked at build time (great SEO).
  Copy is native-proofread Faroese from the Usable source-of-truth fragments.
  JS only enhances — the page is fully readable without it.
-#}

<section class="hero" id="top"
         data-ship-src="{{ '/img/space_ship.png' | url }}"
         data-game-src="{{ '/scripts/game.js' | url }}">
  <div class="container hero__inner">
    <div class="hero__copy">
      {#- "Spæl" is its own element: styled as the statement word, and the
          hook the hero easter egg will attach to. -#}
      <h1 class="hero__title">
        <span class="hero__title-lead">{{ site.tagline.lead }}</span>
        <span class="hero__title-accent" data-hero-accent data-game-trigger>{{ site.tagline.accent }}</span>
      </h1>
      <p class="hero__subtitle">
        Vit fremja telduspælmentan og spælmenning í Føroyum — við game jams
        fyri øll, ið eru áhugað í spølum og spælmenning.
      </p>
      <div class="hero__actions">
        {#- One call to action: sign up for this year's jam. Falls back to the
            events page if the sign-up form link is ever taken down. -#}
        {%- if site.event.signupUrl %}
        <a href="{{ site.event.signupUrl }}"
           class="button button--primary"
           target="_blank"
           rel="noopener">Melda til {{ site.event.name }}</a>
        {%- else %}
        <a href="/tiltok/" class="button button--primary">Sí komandi tiltak</a>
        {%- endif %}
      </div>
    </div>

    {#- Logo art fills this once dropped at src/assets/images/gamejam-logo.png -#}
    {%- if assets.hasLogo %}
    <div class="hero__mascot hero__mascot--filled"
         data-game-trigger
         role="button"
         tabindex="0"
         aria-label="Spæl eitt lítið spæl">
      {% image "src/assets/images/gamejam-logo.png", "GameJam Føroya", "(max-width: 820px) 340px, 40vw", "hero__logo-img" %}
    </div>
    {%- else %}
    <div class="hero__mascot" role="img" aria-label="GameJam Føroya kennimerki">
      <span>Mascot &amp; logo<br>koma her</span>
    </div>
    {%- endif %}
  </div>
</section>

<section class="section" id="about" aria-labelledby="about-title">
  <div class="container">
    <div class="panel">
      <h2 class="section__title" id="about-title">Hvat er GameJam Føroya?</h2>
      <p class="section__lead">
        GameJam Føroya er ein áhugafelagsskapur, sum arbeiðir fyri at menna og
        stuðla føroysku spælvinnuni. Vit skipa fyri tiltøkum – alt innan fyri
        spælmenning. Yvir eitt heilt vikuskifti (48 tímar) menna luttakararnir
        eitt spæl – telduspæl ella borðspæl – út frá einum evni. Tiltakið er
        100% ókeypis fyri luttakararnar.
      </p>
      <p class="section__lead">
        Einki trýst, eingin hørð kapping — bara avslappað skapanarorka, har
        vit sita saman og gera spøl.
      </p>
      <p class="panel__actions">
        <a href="/um-okkum/" class="button button--secondary">Les meira um okkum</a>
      </p>
    </div>
  </div>
</section>

<section class="section" id="video" aria-labelledby="video-title">
  <div class="container">
    <h2 class="section__title" id="video-title">{{ site.video.title }}</h2>
    <p class="section__lead">Ein brellbiti av stemninginum frá okkara seinasta tiltaki.</p>

    <div class="video">
      <div class="video__frame">
        {#- A real link (works with no JS); scripts/main.js upgrades it to
            play inline via the privacy-friendly youtube-nocookie player. -#}
        <a class="video__button"
           href="https://www.youtube.com/watch?v={{ site.video.id }}"
           data-video-id="{{ site.video.id }}"
           aria-label="Spæl video: {{ site.video.title }}">
          {% image "src/assets/images/event-recap-poster.jpg", "", "(max-width: 900px) 100vw, 900px", "video__poster" %}
          <span class="video__play"></span>
        </a>
      </div>
    </div>
  </div>
</section>

<section class="section" id="disciplines" aria-labelledby="disciplines-title">
  <div class="container">
    <h2 class="section__title" id="disciplines-title">Royn teg innan</h2>
    <p class="section__lead">
      Tað er ikki eitt krav, at tú dugir at forrita fyri at vera við. Eitt game
      jam livir av ymiskum evnum — finn títt:
    </p>
    <ul class="disciplines__grid" role="list">
      {%- for discipline in site.disciplines %}
      <li class="disciplines__item">{{ discipline }}</li>
      {%- endfor %}
    </ul>
  </div>
</section>

<section class="section" id="events" aria-labelledby="events-title">
  <div class="container">
    <h2 class="section__title" id="events-title">Komandi tiltak</h2>
    <div class="panel panel--highlight">
      <p><span class="badge">{{ site.event.date }}</span></p>
      <h3 class="panel__title">{{ site.event.name }}</h3>
      <p class="section__lead">{{ site.event.venue }} · {{ site.event.note }}</p>
      <p class="panel__actions">
        {%- if site.event.signupUrl %}
        <a href="{{ site.event.signupUrl }}"
           class="button button--primary"
           target="_blank"
           rel="noopener">Skráset teg</a>
        {%- else %}
        <a href="/samband/" class="button button--primary">Ver við</a>
        {%- endif %}
        <a href="/tiltok/" class="button button--secondary">Øll tiltøk</a>
      </p>
    </div>
  </div>
</section>

<section class="section" id="sponsors" aria-labelledby="sponsors-title">
  <div class="container">
    <h2 class="section__title" id="sponsors-title">Stuðlar</h2>
    <p class="section__lead">
      Tiltakið er ókeypis fyri luttakararnar — tað kann bara eydnast við hjálp
      frá hesum stuðlum:
    </p>
    <ul class="sponsors__grid" role="list">
      {%- for sponsor in site.sponsors %}
      {%- if sponsor.logo %}
      <li class="sponsors__item sponsors__item--logo">
        {% image sponsor.logo, sponsor.name, "(max-width: 600px) 40vw, 200px", "sponsors__logo" + (" sponsors__logo--boxed" if sponsor.boxed else "") %}
      </li>
      {%- else %}
      <li class="sponsors__item">{{ sponsor.name }}</li>
      {%- endif %}
      {%- endfor %}
    </ul>
  </div>
</section>

<section class="section" id="contact" aria-labelledby="contact-title">
  <div class="container">
    <div class="panel">
      <h2 class="section__title" id="contact-title">Fá samband</h2>
      <p class="section__lead">
        Hevur tú spurningar, vilt tú vera við, ella hugsar tú um at stuðla?
      </p>
      <p class="panel__actions">
        <a href="/samband/" class="button button--primary">Fá samband</a>
      </p>
    </div>
  </div>
</section>
