---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
{#- Every public page, for search engines; robots.txt points here. Pages with
    `noindex` in their front matter are left out. -#}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in collections.all %}{% if not p.data.noindex and p.url %}
  <url><loc>{{ site.url }}{{ p.url }}</loc></url>
{%- endif %}{% endfor %}
</urlset>
