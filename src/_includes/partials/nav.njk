{#-
  Primary navigation. Links come from src/_data/site.js (site.nav) so the menu
  is defined in exactly one place. `page.url` marks the current item.
-#}
<nav class="nav" aria-label="Høvuðsvalmynd">
  <a href="/" class="nav__logo">{{ site.name }}</a>

  <button class="nav__toggle" aria-label="Vís/goym valmynd" aria-expanded="false" aria-controls="nav-menu">
    <span class="nav__toggle-bar"></span>
    <span class="nav__toggle-bar"></span>
    <span class="nav__toggle-bar"></span>
  </button>

  <ul class="nav__menu" id="nav-menu" role="list">
    {%- for item in site.nav %}
    <li class="nav__item">
      <a href="{{ item.url }}"
         class="nav__link{% if item.url == page.url %} nav__link--active{% endif %}"
         {% if item.url == page.url %}aria-current="page"{% endif %}>{{ item.text }}</a>
    </li>
    {%- endfor %}
  </ul>
</nav>
