<!DOCTYPE html>
<html lang="{{ site.lang }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  {#- Paint the mobile browser's own top bar the same teal as the sticky
      header, so the two read as one band instead of a darker strip above
      the site. color-scheme keeps phones from force-darkening the page. -#}
  <meta name="theme-color" content="{{ site.themeColor }}">
  <meta name="color-scheme" content="only light">

  {#- SEO: title/description fall back to site-wide defaults when a page omits them -#}
  <title>{% if title %}{{ title }} | {{ site.name }}{% else %}{{ site.name }}{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">

  {#- Open Graph / social sharing -#}
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{% if title %}{{ title }}{% else %}{{ site.name }}{% endif %}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:locale" content="fo_FO">

  {#- Favicon: generated from the logo once supplied, else the placeholder SVG -#}
  {%- if assets.hasLogo %}
  <link rel="icon" href="/img/favicon-32.png" sizes="32x32" type="image/png">
  <link rel="apple-touch-icon" href="/img/favicon-180.png">
  {%- else %}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  {%- endif %}

  {#- Base styles first, then BEM component styles (parallel <link>s, no @import) -#}
  <link rel="stylesheet" href="/styles/main.css">
  <link rel="stylesheet" href="/styles/components/nav.css">
  <link rel="stylesheet" href="/styles/components/hero.css">
  <link rel="stylesheet" href="/styles/components/panel.css">
  <link rel="stylesheet" href="/styles/components/video.css">
  <link rel="stylesheet" href="/styles/components/game.css">
  <link rel="stylesheet" href="/styles/components/disciplines.css">
  <link rel="stylesheet" href="/styles/components/sponsors.css">
  <link rel="stylesheet" href="/styles/components/events.css">
  <link rel="stylesheet" href="/styles/components/contact.css">
  <link rel="stylesheet" href="/styles/components/footer.css">
  {#- NB: styles/components/review.css is NOT linked here on purpose — the
      hidden review mode (scripts/review.js) injects it on demand so ordinary
      visitors never download any review-mode bytes. -#}
  {%- if extraStyles %}{% for href in extraStyles %}
  <link rel="stylesheet" href="{{ href }}">
  {%- endfor %}{% endif %}
</head>
<body>
  <a href="#main" class="skip-link">Leyp til innihald</a>

  {% include "partials/header.njk" %}

  <main id="main">
    {{ content | safe }}
  </main>

  {% include "partials/footer.njk" %}

  {#- Progressive enhancement only — the page is fully readable without this -#}
  <script src="/scripts/main.js" defer></script>
</body>
</html>
